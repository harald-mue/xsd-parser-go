<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:tns="http://example.com/local"
           targetNamespace="http://example.com/local"
           elementFormDefault="qualified">
  <xs:complexType name="ContainerType">
    <xs:sequence>
      <xs:element name="KnownLocal" type="xs:string"/>
      <xs:any namespace="##targetNamespace" processContents="strict" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="knownLocalAttr" type="xs:string"/>
    <xs:anyAttribute namespace="##local" processContents="strict"/>
  </xs:complexType>
  <xs:element name="Container" type="tns:ContainerType"/>
</xs:schema>
