<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:tns="http://example.com/scalars"
           targetNamespace="http://example.com/scalars"
           elementFormDefault="qualified">
  <xs:simpleType name="AmountType">
    <xs:annotation><xs:documentation>is an exact decimal amount.</xs:documentation></xs:annotation>
    <xs:restriction base="xs:decimal">
      <xs:totalDigits value="6"/>
      <xs:fractionDigits value="2"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:complexType name="ScalarHolderType">
    <xs:annotation><xs:documentation>contains representative XSD scalar values.</xs:documentation></xs:annotation>
    <xs:sequence>
      <xs:element name="Created" type="xs:dateTime"><xs:annotation><xs:documentation>is the creation timestamp.</xs:documentation></xs:annotation></xs:element>
      <xs:element name="Birthday" type="xs:date"/>
      <xs:element name="Clock" type="xs:time"/>
      <xs:element name="Period" type="xs:duration"/>
      <xs:element name="Amount" type="tns:AmountType"/>
      <xs:element name="Payload" type="xs:base64Binary"/>
      <xs:element name="Digest" type="xs:hexBinary"/>
      <xs:element name="Year" type="xs:gYear"/>
    </xs:sequence>
  </xs:complexType>
  <xs:element name="ScalarHolder" type="tns:ScalarHolderType"/>
</xs:schema>
