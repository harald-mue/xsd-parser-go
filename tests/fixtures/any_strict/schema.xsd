<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:tns="http://example.com"
           targetNamespace="http://example.com"
           elementFormDefault="qualified">

  <xs:complexType name="ContainerType">
    <xs:sequence>
      <xs:element name="Name" type="xs:string"/>
      <xs:any namespace="##any" processContents="strict" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:anyAttribute namespace="##any" processContents="strict"/>
  </xs:complexType>

  <xs:element name="Container" type="tns:ContainerType"/>
  <xs:element name="Known" type="xs:string"/>
  <xs:element name="Extension" type="xs:string"/>

  <xs:attribute name="KnownAttr" type="xs:string"/>
  <xs:attribute name="ExtensionAttr" type="xs:string"/>
</xs:schema>
