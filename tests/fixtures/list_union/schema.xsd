<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:tns="http://example.com"
           targetNamespace="http://example.com"
           elementFormDefault="qualified">
  <xs:simpleType name="TagsType">
    <xs:list itemType="xs:string"/>
  </xs:simpleType>
  <xs:simpleType name="NumbersType">
    <xs:list itemType="xs:int"/>
  </xs:simpleType>
  <xs:simpleType name="SmallCodeType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="A"/>
      <xs:enumeration value="B"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="CodeOrTextType">
    <xs:union memberTypes="tns:SmallCodeType xs:string"/>
  </xs:simpleType>
  <xs:complexType name="ItemType">
    <xs:sequence>
      <xs:element name="Tags" type="tns:TagsType"/>
      <xs:element name="Numbers" type="tns:NumbersType"/>
      <xs:element name="CodeOrText" type="tns:CodeOrTextType"/>
    </xs:sequence>
  </xs:complexType>
  <xs:element name="Item" type="tns:ItemType"/>
</xs:schema>
