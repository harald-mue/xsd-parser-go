<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:tns="urn:legacy:exception"
           targetNamespace="urn:legacy:exception"
           elementFormDefault="qualified">

  <xs:complexType name="WebRTCException">
    <xs:sequence>
      <xs:element name="errorCode" type="xs:string"/>
      <xs:element name="errorMessage" type="xs:string" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <!-- Global element declaration used on the wire -->
  <xs:element name="webRTCException" type="tns:WebRTCException"/>
</xs:schema>
